@model TayanaYachts.Models.ViewModels.DealerVM

@{
    ViewBag.PageHeader = "Dealer";
}

@using (Html.BeginForm("Edit","Dealer", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Edit</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <div class="form-group">
        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Content, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.Content, new { htmlAttributes = new { @class = "form-control", rows = 10 } })
            @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
        </div>
    </div>

    <div>
        <p>
            <img src="@Url.Content(Model.FilePath)" border="0" />
        </p>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Upload New Image</label>
        <div class="col-md-10">
            <input type="file"
                   name="ImageFile"
                   class="form-control"
                   accept="image/*" />
            @Html.ValidationMessageFor(model => model.ImageFile, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.CountryId, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(
                model => model.CountryId,
                Model.CountryList,
                "-- Select Country --",
                new { @class = "form-select", id = "CountryId" })
            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.AreaId, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(
                model => model.AreaId,
                Model.AreaList,
                "-- Select Area --",
                new { @class = "form-select", id = "AreaId" })
            @Html.ValidationMessageFor(model => model.AreaId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.SortOrder, htmlAttributes: new { @class = "form-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.SortOrder, new
       {
           @class = "form-control",
           type = "number",
           min = "0",
           max = "9999",
           step = "1",
           placeholder = "Leave empty to keep current order"
       })
            @Html.ValidationMessageFor(model => model.SortOrder, "", new { @class = "text-danger" })
            <small class="form-text text-muted">Lower numbers appear first. Leave empty to keep current order.</small>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-primary" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section styles{
    <link href="~/Content/summernote/summernote-lite.min.css" rel="stylesheet" />
}

@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/summernote/summernote-lite.min.js"></script>
    <script>
        $(function () {

            // Initialize Summernote on the dealer content textarea.
            var $content = $('#Content');

            $content.summernote({
                height: 300,
                tooltip: false,
                toolbar: [
                    ['style', ['bold', 'italic', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['fontsize', ['fontsize']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['height', ['height']],
                    ['table', ['table']],
                    ['insert', ['link']],
                    ['view', ['codeview', 'help']]
                ],
                callbacks: {
                    onPaste: function (e) {
                        // Paste plain text only, then convert line breaks to HTML breaks.
                        e.preventDefault();
                        var bufferText = ((e.originalEvent || e).clipboardData || window.ClipboardData).getData('text/plain');

                        var pastedText = $('<div>').text(bufferText).html();

                        pastedText = pastedText.replace(/(?:\r\n|\r|\n)/g, '<br>');
                        $(this).summernote('pasteHTML', pastedText);
                    },
                }
            });

            // Copy Summernote HTML back to the textarea before MVC model binding runs.
            $content.closest('form').on('submit', function () {
                $content.val($content.summernote('code'));
            });

            // Reload the Area dropdown when the selected Country changes.
            $("#CountryId").change(function () {
                var countryId = $(this).val();
                var areaDropdown = $("#AreaId");

                // Clear stale area options before loading areas for the newly selected country.
                areaDropdown.empty();
                areaDropdown.append($("<option></option>").val("").text("-- Select Area --"));

                if (countryId) {
                    // Ask the controller for areas that belong to the selected country.
                    $.ajax({
                        url: '@Url.Action("GetAreaByCountry", "Dealer")',
                        type: 'GET',
                        data: { countryId: countryId },
                        success: function (areas) {
                            // Add each returned area as an option in the Area dropdown.
                            $.each(areas, function (index, area) {
                                areaDropdown.append(
                                    $("<option></option>").val(area.id).text(area.name)
                                );
                            });
                        }
                    });
                }
            });
        });
    </script>
}
