@model TayanaYachts.Models.Yacht

@{
    ViewBag.PageHeader = "Yacht";
    var heroImage = ViewBag.HeroImage as TayanaYachts.Models.ViewModels.ExistingUploadFileVM;
}


<div>
    <h4>Details</h4>
    <hr />
    <dl class="mb-4">
        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd class="mb-3">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.IsNew)
        </dt>

        <dd class="mb-3">
            @Html.DisplayFor(model => model.IsNew)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.IsPublished)
        </dt>

        <dd class="mb-3">
            @Html.DisplayFor(model => model.IsPublished)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.PostDate)
        </dt>

        <dd class="mb-3">
            @Html.DisplayFor(model => model.PostDate)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.SortOrder)
        </dt>

        <dd class="mb-3">
            @Html.DisplayFor(model => model.SortOrder)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Overview)
        </dt>

        <dd class="mb-3">
            @Html.Raw(Model.Overview)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Dimensions)
        </dt>

        <dd class="mb-3">
            @Html.Raw(Model.Dimensions)
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Specification)
        </dt>

        <dd class="mb-3">
            @Html.Raw(Model.Specification)
        </dd>

        <dt class="mb-1">
            Homepage Hero Image
        </dt>

        <dd class="mb-3">
            @if (heroImage != null)
            {
                <div>
                    <img src="@Url.Content(heroImage.FilePath)"
                         alt="@heroImage.OriginalFileName"
                         style="max-width: 240px;"/>
                    <div>
                        <a href="@Url.Content(heroImage.FilePath)" target="_blank" rel="noopener noreferrer">
                            @heroImage.OriginalFileName
                        </a>
                    </div>
                </div>
            }
            else
            {
                <span class="text-muted">No homepage hero image.</span>
            }
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.DeckImgs)
        </dt>

        <dd class="mb-3">
            @if (Model.DeckImgs != null && Model.DeckImgs.Any())
            {
                <div class="vstack gap-3">
                    @foreach (var deckImage in Model.DeckImgs)
                    {
                        <figure class="figure mb-0">
                            <img src="@Url.Content(deckImage.FilePath)"
                                 alt="@deckImage.OriginalFileName"
                                 class="figure-img img-fluid" />
                            <figcaption class="figure-caption">
                                @deckImage.OriginalFileName
                            </figcaption>
                        </figure>
                    }
                </div>
            }
            else
            {
                <p class="text-body-secondary mb-0">No Layout & deck plan image.</p>
            }
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Interiors)
        </dt>

        <dd class="mb-3">
            @if (Model.Interiors != null && Model.Interiors.Any())
            {
                <div class="vstack gap-3">
                    @foreach (var interior in Model.Interiors)
                    {
                        <figure class="figure mb-0">
                            <img src="@Url.Content(interior.FilePath)"
                                 alt="@interior.OriginalFileName"
                                 class="figure-img img-fluid" />
                            <figcaption class="figure-caption">
                                @interior.OriginalFileName
                            </figcaption>
                        </figure>
                    }
                </div>
            }
            else
            {
                <p class="text-body-secondary mb-0">No Interior image.</p>
            }
        </dd>

        <dt class="mb-1">
            @Html.DisplayNameFor(model => model.Downloads)
        </dt>

        <dd class="mb-3">
            @if (Model.Downloads != null && Model.Downloads.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var file in Model.Downloads)
                    {
                        <li class="mb-2">
                            <a href="@Url.Content(file.FilePath)" target="_blank" rel="noreferrer noopener">
                                @file.OriginalFileName
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-body-secondary mb-0">No files.</p>
            }
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Index")
</p>
