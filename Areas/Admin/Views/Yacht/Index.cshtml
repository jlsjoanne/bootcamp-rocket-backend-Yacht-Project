@model PagedList.IPagedList<TayanaYachts.Models.Yacht>
@using PagedList.Mvc;

@{
    ViewBag.PageHeader = "Yacht";
}

<div class="mb-3">
    @Html.ActionLink("Create New", "Create", "Yacht", null, new { @class = "btn btn-outline-primary" })
</div>

<div class="mb-3">
    @using (Html.BeginForm("Index", "Yacht", FormMethod.Get))
    {
        <label for="searchString">Search Name and Overview</label>

        <div class="input-group" style="max-width: 420px;">
            <input type="search"
                   id="searchString"
                   name="searchString"
                   value="@ViewBag.CurrentFilter"
                   class="form-control"
                   placeholder="Search yacht..." />
            <button type="submit" class="btn btn-outline-secondary">
                Search
            </button>
        </div>
    }
</div>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().IsNew)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().IsPublished)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().PostDate)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPublished)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PostDate)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
    }

</table>

<br />

Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { page, currentFilter = ViewBag.CurrentFilter }))

@section styles{
    <link href="@Url.Content("~/Content/PagedList.css")" rel="stylesheet" type="text/css" />
}