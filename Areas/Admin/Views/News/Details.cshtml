@model TayanaYachts.Models.News

@{
    ViewBag.PageHeader = "News";
}

<div>
    <h4>Details</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Title)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Summary)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Summary)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Content)
        </dt>

        <dd>
            <div style="white-space: pre-line;">
                @Html.DisplayFor(model => model.Content)
            </div>
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.PublishDate)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.PublishDate)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.IsPinned)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.IsPinned)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.IsPublished)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.IsPublished)
        </dd>

        <dt>
            Images
        </dt>

        <dd>
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="row g-3">
                    @foreach (var image in Model.Images)
                    {
                        var isThumbnail = image.Id == Model.ThumbnailImageId;

                        <div class="col-md-3">
                            <figure class="image-figure mb-0 h-100">
                                <a href="@Url.Content(image.FilePath)" target="_blank" rel="noopener noreferrer" class="d-block">
                                    <img src="@Url.Content(image.FilePath)"
                                         alt="@image.OriginalFileName"
                                         class="img-thumbnail image-thumb" />
                                </a>
                                <figcaption class="image-caption small text-body-secondary mt-1">
                                    <span class="d-inline-block text-truncate image-file-name">
                                        @image.OriginalFileName
                                    </span>
                                    @if (isThumbnail)
                                    {
                                        <span class="badge bg-info ms-1">
                                            Thumbnail
                                        </span>
                                    }
                                </figcaption>
                            </figure>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-body-secondary mb-0">No images.</p>
            }
        </dd>

        <dt>
            Files
        </dt>

        <dd>
            @if (Model.Files != null && Model.Files.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var file in Model.Files)
                    {
                        <li class="mb-2">
                            <a href="@Url.Content(file.FilePath)" target="_blank" rel="noreferrer noopener">
                                @file.OriginalFileName
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-body-secondary mb-0">No files.</p>
            }
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Index")
</p>

@section styles{
    <style>
        .image-figure {
            display: flex;
            flex-direction: column;
        }

        .img-thumbnail.image-thumb {
            width: 100%;
            height: 300px;
            object-fit: contain;
        }

        .image-caption {
            min-height: 2.5rem;
        }

        .image-file-name {
            max-width: 100%;
            vertical-align: middle;
        }
    </style>
    }