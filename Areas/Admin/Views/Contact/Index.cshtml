@model IEnumerable<TayanaYachts.Models.Contact>

@{
    ViewBag.PageHeader = "Contact";
}


<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Phone)
        </th>
        <th>
            Country
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsCompleted)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsCompleted)
            </td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.Id })
                @if (!item.IsCompleted)
                {
                    @: |
                    using (Html.BeginForm("MarkAsComplete", "Contact", FormMethod.Post, new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", item.Id)
                        <button type="submit" class="btn btn-sm btn-success">Mark as Complete</button>
                    }
                }
                else
                {
                    @: |
                    using (Html.BeginForm("MarkAsIncomplete", "Contact", FormMethod.Post, new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", item.Id)
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as Incomplete</button>
                    }
                }
                |
                @using (Html.BeginForm("Delete", "Contact", FormMethod.Post, new { style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", item.Id)
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                }
            </td>
        </tr>
    }

</table>
